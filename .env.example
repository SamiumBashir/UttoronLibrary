# Uttoron Prokasoni Environment Configuration
# Copy to .env.local and fill in credentials for database, Firebase, and payment gateways.

# -----------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration (Prisma)
# -----------------------------------------------------------------------------
# Supports Neon, Supabase, Railway, Vercel Postgres, or Local PostgreSQL
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/uttoron_prokasoni?schema=public"

# -----------------------------------------------------------------------------
# 2. Firebase Client Configuration (Frontend Auth & Storage)
# -----------------------------------------------------------------------------
# Obtain from Firebase Console -> Project Settings -> General -> Your Apps (Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# 3. Firebase Admin Configuration (Server-Side Token Verification)
# -----------------------------------------------------------------------------
# Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# 4. Curator / Admin Setup
# -----------------------------------------------------------------------------
# First user created with this email is automatically granted Curator/Admin role
ADMIN_SETUP_EMAIL=admin@uttoronprokasoni.com

# -----------------------------------------------------------------------------
# 5. Application & Session
# -----------------------------------------------------------------------------
# Session signing secret (auto-generated in data/.session-secret if omitted)
SESSION_SECRET=

# Public Site URL (used for payment gateway callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 6. Payment Gateways (Configurable)
# -----------------------------------------------------------------------------
# Cash on Delivery (enabled by default; set to "false" to disable)
PAYMENTS_ENABLE_COD=true

# bKash Tokenized Checkout (Optional — leave blank if not connected yet)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Nagad Payment Gateway (Optional — leave blank if not connected yet)
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=

# Card / Online Payment Gateway (SSLCommerz or Stripe — Optional)
CARD_GATEWAY_PROVIDER=sslcommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_IS_SANDBOX=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

